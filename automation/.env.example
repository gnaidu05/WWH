# Copy to .env (or export in your shell / set as GitHub Actions secrets)

# Script generation — optional; without it a template fallback is used
ANTHROPIC_API_KEY=

# Stock b-roll — free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube upload — from Google Cloud OAuth client (Desktop app) +
#   `python -m pipeline.upload --authorize`
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
